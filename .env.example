GOOGLE_API_KEY=your_google_api_key_here
# GEMINI_MODEL=gemini-2.0-flash
# LLM_PROVIDER=auto            # auto | gemini | mock
# EMBEDDING_PROVIDER=tfidf_svd # tfidf_svd | sentence_transformers
# EMBEDDING_MODEL=all-MiniLM-L6-v2
